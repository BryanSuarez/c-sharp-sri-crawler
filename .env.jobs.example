# Copy to .env.jobs. Development reads project/root files; process environment wins.
ExtractionJobs__ConnectionString="Host=127.0.0.1;Port=5432;Database=sri;Username=sri;Password=CHANGE_ME"
# Generate once: openssl rand -base64 32. Keep it stable across API/worker restarts.
ExtractionJobs__EncryptionKey=REPLACE_WITH_A_BASE64_32_BYTE_KEY
ExtractionJobs__ParserUrl=http://localhost:3000
ExtractionJobs__SyncWaitSeconds=120
ExtractionJobs__WorkerCount=1
# Apply the same workload configuration to every API/worker replica.
# Pending includes queued/running/retrying work with unexpired credentials, plus cancellation requests awaiting cleanup.
ExtractionJobs__MaxPendingPerCompany=25
# Rolling 24 hours; each accepted extraction counts once, including failed work.
ExtractionJobs__MaxAcceptedPerCompany24Hours=1000
ExtractionJobs__MaxConcurrentPerCompany=1
# Global publication capacity across dispatchers; raise with available worker capacity.
ExtractionJobs__MaxDispatchedExtractions=1
ExtractionJobs__AttemptTimeoutHours=6
ExtractionJobs__CredentialLifetimeHours=24
# Cooperative cancellation polling; cleanup may take longer (range 1-30 seconds).
ExtractionJobs__CancellationPollIntervalSeconds=2
ExtractionJobs__ParserTimeoutSeconds=30
ExtractionJobs__DashboardEnabled=false
# Docker only: set the same PostgreSQL password used above.
POSTGRES_PASSWORD=CHANGE_ME

# Received document validation (applies to API and worker).
DocumentValidation__PortalTimeZone=America/Guayaquil
DocumentValidation__MaxXmlBytes=20971520
DocumentValidation__MaxPdfBytes=20971520
DocumentValidation__MaxPdfPages=1000
