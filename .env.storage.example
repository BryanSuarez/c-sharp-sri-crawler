# Copy this file to .env.storage. Never commit real credentials.
# The API accepts companyId in the body. Provider and bucket are server configuration only.
DOCUMENT_STORAGE_PROVIDER=Local
DOCUMENT_STORAGE_BUCKET=
DOCUMENT_STORAGE_SERVICE_URL=
DOCUMENT_STORAGE_FORCE_PATH_STYLE=false
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=   # Optional temporary AWS credentials

# Amazon S3: set DOCUMENT_STORAGE_PROVIDER=S3, bucket, region and access keys.
# Leave DOCUMENT_STORAGE_SERVICE_URL empty for the standard AWS regional endpoint.

# Cloudflare R2: set DOCUMENT_STORAGE_PROVIDER=R2, bucket and R2 access keys.
# DOCUMENT_STORAGE_SERVICE_URL=https://<account-id>.r2.cloudflarestorage.com
# AWS_REGION=auto  # R2 always uses auto internally.
# DOCUMENT_STORAGE_FORCE_PATH_STYLE=false

# DOCUMENT_STORAGE_DEFAULT_ORGANIZATION_ID is not used. companyId is required per request.
