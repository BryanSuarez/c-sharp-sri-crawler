# Generate private values with: python3 scripts/setup-api-security.py
# Only the API receives these options. Required is the default.
ApiSecurity__Mode=required
ApiSecurity__AdministratorId=
ApiSecurity__AdministratorHash=
ApiSecurity__DefaultKeyLifetimeDays=90
# For native local development only:
# ASPNETCORE_ENVIRONMENT=Development
# ApiSecurity__Mode=localDevelopment
